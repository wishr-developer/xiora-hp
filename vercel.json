{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/r.js": {
      "runtime": "nodejs20.x",
      "memory": 128,
      "maxDuration": 5
    }
  },
  "headers": [
    {
      "source": "/r",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
